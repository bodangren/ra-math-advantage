{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-platform.local/schemas/lms-architecture.v1.json",
  "title": "LMS Architecture Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaces", "temporaryDebt"],
  "properties": {
    "schemaVersion": { "const": "lms-architecture.v1" },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workspace" }
    },
    "temporaryDebt": {
      "type": "array",
      "items": { "$ref": "#/$defs/debt" }
    }
  },
  "$defs": {
    "qualityCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lint", "test", "typecheck", "build"],
      "properties": {
        "lint": { "type": ["string", "null"], "minLength": 1 },
        "test": { "type": ["string", "null"], "minLength": 1 },
        "typecheck": { "type": ["string", "null"], "minLength": 1 },
        "build": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind", "packageName", "owner", "layer", "domainClassification", "domain", "allowedDependencies", "publicEntryPoints", "qualityCommands", "debtRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["app", "package"] },
        "packageName": { "type": ["string", "null"] },
        "owner": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["application", "domain-content", "feature", "platform", "infrastructure"] },
        "domainClassification": { "enum": ["app-owned", "domain-specific", "domain-neutral"] },
        "domain": { "type": ["string", "null"] },
        "allowedDependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "publicEntryPoints": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "qualityCommands": { "$ref": "#/$defs/qualityCommands" },
        "debtRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "sourceWorkspace", "targetWorkspace", "importPattern"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "sourceWorkspace": { "type": "string", "minLength": 1 },
        "targetWorkspace": { "type": ["string", "null"] },
        "importPattern": { "type": "string", "minLength": 1 }
      }
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "rationale", "followUpTrack", "expiresOn", "violations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "followUpTrack": { "type": "string", "minLength": 1 },
        "expiresOn": { "type": "string", "format": "date" },
        "violations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/violation" } }
      }
    }
  }
}
