{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ra-math-advantage.local/oxlint-migration/legacy-policy.schema.json",
  "title": "ESLint to Oxlint legacy policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "entries"],
  "properties": {
    "$schema": { "const": "./legacy-policy.schema.json" },
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "workspaceGlobs",
        "fileGlobs",
        "sourceConfigs",
        "legacyRule",
        "targetRule",
        "severity",
        "options",
        "provider",
        "disposition"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "profile": {
          "enum": [
            "app-production",
            "app-test",
            "im3-test",
            "package-production",
            "package-shared-production",
            "package-test",
            "lesson-renderer-test",
            "math-content-production",
            "math-content-test"
          ]
        },
        "workspaceGlobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fileGlobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceConfigs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          }
        },
        "legacyRule": { "type": "string", "minLength": 1 },
        "targetRule": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "severity": { "enum": ["off", "warning", "error"] },
        "options": { "type": "array" },
        "provider": {
          "enum": ["native", "eslint-js", "react-js", "react-hooks-js", "none"]
        },
        "disposition": {
          "enum": ["native", "javascript-plugin", "remove-obsolete"]
        }
      }
    }
  }
}
