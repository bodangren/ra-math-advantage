{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "exceptions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policyId", "targetRule", "status", "reason"],
        "properties": {
          "policyId": { "type": "string", "minLength": 1 },
          "targetRule": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending-owner-approval", "approved"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
