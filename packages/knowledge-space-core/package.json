{
  "name": "@math-platform/knowledge-space-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./schemas": "./src/schemas.ts",
    "./validation": "./src/validation.ts",
    "./level-projection": "./src/level-projection.ts",
    "./progress-trend": "./src/progress-trend.ts",
    "./adapters": "./src/adapters.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "oxlint --config ../../.oxlintrc.json src --max-warnings 0",
    "typecheck": "TSRS_FAST=1 oxlint --config ../../.oxlintrc.json --type-aware --type-check --max-warnings 0 src",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "@math-platform/srs-engine": "*"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
