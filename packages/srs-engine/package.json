{
  "name": "@math-platform/srs-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/srs/contract.ts",
    "./scheduler": "./src/srs/scheduler.ts",
    "./review-processor": "./src/srs/review-processor.ts",
    "./queue": "./src/srs/queue.ts",
    "./evidence": "./src/srs/proficiency-evidence.ts",
    "./scheduler-policy": "./src/srs/scheduler-policy-contract.ts",
    "./fsrs-fitting": "./src/srs/fsrs-fitting.ts",
    "./evaluation": "./src/srs/evaluation-harness.ts",
    "./placement": "./src/srs/placement.ts",
    "./placement-contract": "./src/srs/placement-contract.ts",
    "./adaptive-placement": "./src/srs/adaptive-placement.ts",
    "./adapters": "./src/srs/adapters.ts",
    "./submission-adapter": "./src/srs/submission-srs-adapter.ts",
    "./session-composition-contract": "./src/srs/session-composition-contract.ts",
    "./session-composition": "./src/srs/session-composition.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "oxlint --config ../../.oxlintrc.json src --max-warnings 0",
    "typecheck": "TSRS_FAST=1 oxlint --config ../../.oxlintrc.json --type-aware --type-check --max-warnings 0 src",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "@math-platform/practice-core": "*",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
