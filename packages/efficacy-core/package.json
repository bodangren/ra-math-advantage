{
  "name": "@math-platform/efficacy-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./metrics/retention": "./src/metrics/retention.ts",
    "./metrics/time-to-mastery": "./src/metrics/time-to-mastery.ts",
    "./metrics/accuracy": "./src/metrics/accuracy.ts",
    "./metrics/review-success": "./src/metrics/review-success.ts",
    "./experiment/assign": "./src/experiment/assign.ts",
    "./experiment/registry": "./src/experiment/registry.ts",
    "./experiment/report": "./src/experiment/report.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "oxlint --config ../../.oxlintrc.json src --max-warnings 0",
    "typecheck": "TSRS_FAST=1 oxlint --config ../../.oxlintrc.json --type-aware --type-check --max-warnings 0 src",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "@math-platform/srs-engine": "*",
    "@math-platform/practice-core": "*",
