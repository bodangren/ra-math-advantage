{
  "name": "@math-platform/study-hub-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./shuffle": "./src/study/shuffle.ts",
    "./base-session": "./src/study/base-session.tsx",
    "./types": "./src/study/types.ts",
    "./games": "./src/games/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "oxlint --config ../../.oxlintrc.json src --max-warnings 0",
    "typecheck": "TSRS_FAST=1 oxlint --config ../../.oxlintrc.json --type-aware --type-check --max-warnings 0 src",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "vitest": "^4.1.8"
  }
}
