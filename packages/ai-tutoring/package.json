{
  "name": "@math-platform/ai-tutoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./retry": "./src/retry.ts",
    "./providers": "./src/providers.ts",
    "./lesson-context": "./src/lesson-context.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:workerd": "node workerd-probe/run.mjs",
    "lint": "oxlint --config ../../.oxlintrc.json src --max-warnings 0",
    "typecheck": "TSRS_FAST=1 oxlint --config ../../.oxlintrc.json --type-aware --type-check --max-warnings 0 src",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.5.102"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vitest": "^4.1.8"
  }
}
