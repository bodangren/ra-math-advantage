{
  "name": "@math-platform/app-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers/index.ts",
    "./auth": "./src/auth/index.ts",
    "./components": "./src/components/index.ts",
    "./layout": "./src/layout/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "oxlint --config ../../.oxlintrc.json src --max-warnings 0",
    "typecheck": "TSRS_FAST=1 oxlint --config ../../.oxlintrc.json --type-aware --type-check --max-warnings 0 src",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "@math-platform/core-auth": "*",
    "@math-platform/core-convex": "*",
    "convex": "^1.51.0",
    "lucide-react": "^1.77.0",
    "next-themes": "^0.4.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "vinext": "^1.4.5",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "^19",
    "vinext": "^1.4.5"
  }
}
