# Public Convex URL for the browser and server.
# Local Convex uses this URL by default.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Secret for the shared session cookie.
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Production key for server-side internal Convex calls.
# CONVEX_DEPLOY_KEY=replace-with-the-production-deploy-key

# Set this only when a trusted proxy adds a client IP header.
# Vercel deployments do not need this setting.
# Production sign-in fails when the configured header is missing.
# TRUSTED_CLIENT_IP_HEADER=x-school-client-ip
