{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "oxlint --config ../../.oxlintrc.json . --max-warnings 0",
    "typecheck": "TSRS_FAST=1 oxlint --config ../../.oxlintrc.json --type-aware --type-check --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "curriculum:build": "node scripts/build-curriculum.mjs && node scripts/build-calendar.mjs",
    "curriculum:check": "node scripts/build-curriculum.mjs --check && node scripts/build-calendar.mjs --check",
    "prebuild": "npm run curriculum:check",
    "typecheck:backend": "tsc --noEmit -p convex/tsconfig.json",
    "curriculum:audit": "vitest run __tests__/curriculum"
  },
  "dependencies": {
    "@math-platform/activity-runtime": "*",
    "@math-platform/app-shell": "*",
    "@math-platform/core-auth": "*",
    "@math-platform/core-convex": "*",
    "@math-platform/lesson-renderer": "*",
    "@math-platform/math-content": "*",
    "@math-platform/practice-core": "*",
    "@math-platform/srs-engine": "*",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.50.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.73.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.37",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.0",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "vinext": "^1.4.5",
    "vite": "^8.3.8",
    "vitest": "^4.1.8",
    "wrangler": "^4.81.1"
  }
