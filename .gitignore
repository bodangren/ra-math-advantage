.wrangler/

# build-graph scratch artifacts (graph.db itself is tracked; these are not)
*.db.backup
graph-bm2.db

# python bytecode
__pycache__/

# measure automation-supervisor run outputs
/measure/runs/

# scale harness runner output (regenerated on every run; do not commit)
/scale-report.json
/scale-evaluation.json
apps/*/scale-report.json
apps/*/scale-evaluation.json

# Junk files created by misfired CLI flag invocations (e.g. `build-graph --db`
# treated as a literal filename rather than a flag). See
# code-review-remediation_20260624 FR-15.
/--db
/--symbol
*-cli-arg-junk
