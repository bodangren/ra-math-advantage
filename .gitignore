# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
**/coverage/
/playwright-report
**/playwright-report/
**/test-results/

# next.js
/.next/
# vinext build caches (apps; IM3 tracks .next/types/routes.d.ts, which stays tracked)
apps/*/.next/
apps/*/.vinext/
/out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# convex
**/convex/_generated/

# drizzle
drizzle/meta/

# wrangler
.wrangler/

# build-graph scratch artifacts (graph.db itself is tracked; these are not)
*.db.backup
graph-bm2.db

# python bytecode
__pycache__/

# measure automation-supervisor run outputs
/measure/runs/

# scale harness runner output (regenerated on every run; do not commit)
/scale-report.json
/scale-evaluation.json
apps/*/scale-report.json
apps/*/scale-evaluation.json

# scratch capture scripts and generated evidence output (kept on disk, not tracked)
/tmp/

# Junk files created by misfired CLI flag invocations (e.g. `build-graph --db`
# treated as a literal filename rather than a flag). See
# code-review-remediation_20260624 FR-15.
/--db
/--symbol
/=
*-cli-arg-junk

# Throwaway JSDoc automation scratch files (do not commit)
_add_types.py
_add_types.ts
